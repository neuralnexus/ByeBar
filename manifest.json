{
  "manifest_version": 3,
  "name": "ByeBar; Overlay & Popup Blocker",
  "short_name": "ByeBar",
  "description": "Remove distracting popups and make pages easier to browse. Blocks newsletter overlays, cookie banners, and more. Not an ad-blocker.",
  "version": "0.8.0",
  "homepage_url": "https://byebar.mattivan.com/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png",
    "1024": "icons/icon-1024.png"
  },
  "action": {
    "default_title": "ByeBar",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "24": "icons/toolbar-24.png",
      "32": "icons/toolbar-32.png",
      "48": "icons/toolbar-48.png",
      "64": "icons/toolbar-64.png"
    }
  },
  "commands": {
    "sweep-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Run ByeBar Sweep on the active page"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/runtime.generated.js",
        "shared/browser.js",
        "shared/substack-detect.js",
        "content/safari-compat.js",
        "content/selectors.js",
        "content/shadow.js",
        "content/visibility.js",
        "content/actions.js",
        "content/picker.js",
        "content/engine.js",
        "content/cookies.js",
        "content/tos.js",
        "content/china-commerce.js",
        "content/main.js"
      ],
      "css": ["content/styles.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "byebar@neuralnexus.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "safari": {
      "strict_min_version": "16.4"
    }
  }
}
